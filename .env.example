# Copie para .env (testes locais) ou cadastre na Vercel em Settings > Environment Variables.
# Nunca coloque valores reais neste arquivo.

# Senha do modo edição (mínimo 8 caracteres; use 12+).
SENHA_EDICAO=

# Token "fine-grained" do GitHub com acesso só a este repositório: Contents = Read and write.
GITHUB_TOKEN=
# dono/repositório
GITHUB_REPO=Yuri-Dev-OH/conselho-dos-passaros
GITHUB_BRANCH=main
